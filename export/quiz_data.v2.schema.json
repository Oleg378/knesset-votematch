{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quiz_data.v2.schema.json",
  "title": "Knesset 2026 quiz data, version 2",
  "description": "Produced by pipeline/export.py. The only input of web/. Formulas: docs/QUIZ_MATCHING.md. v2 (2026-10-17): position formula P = A + 0.25 V; bills not about the statements' issue removed; P_bills; CLOSE.",
  "type": "object",
  "required": [
    "version",
    "generated",
    "source_commit",
    "params",
    "statements",
    "directions",
    "lists",
    "mks",
    "by_direction",
    "bills"
  ],
  "additionalProperties": false,
  "$defs": {
    "listId": {
      "type": "string",
      "description": "Ballot letters of the list (official CEC id), e.g. \"אמת\"."
    },
    "mkId": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "Knesset person id."
    },
    "billId": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "Knesset bill id."
    },
    "dirId": {
      "type": "string",
      "description": "Direction key, e.g. \"72\" or \"277a\"."
    },
    "sign": {
      "enum": [
        1,
        -1
      ]
    }
  },
  "properties": {
    "version": {
      "const": 2
    },
    "generated": {
      "type": "string",
      "format": "date"
    },
    "source_commit": {
      "type": "string"
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "K",
        "MIN_COVERAGE",
        "MAX_TRADE",
        "TRADE_TOP",
        "TRADE_W",
        "TRADE_CANDIDATES",
        "VOTE_WEIGHT",
        "CLOSE"
      ],
      "properties": {
        "K": {
          "type": "number",
          "description": "Shrinkage: p = P * e / (e + K)."
        },
        "MIN_COVERAGE": {
          "type": "number",
          "description": "A list covering less of the answered weight is not ranked."
        },
        "MAX_TRADE": {
          "type": "integer",
          "description": "Max trade-off questions."
        },
        "TRADE_TOP": {
          "type": "integer",
          "description": "Trade-offs are asked only if they change the order of this top."
        },
        "TRADE_W": {
          "type": "number",
          "description": "Weight multiplier of the statement chosen in a trade-off."
        },
        "TRADE_CANDIDATES": {
          "type": "integer",
          "description": "Statements tried on each side per list."
        },
        "VOTE_WEIGHT": {
          "type": "number",
          "description": "Weight of a vote vs a sponsored bill in e (informational)."
        },
        "CLOSE": {
          "type": "number",
          "description": "|p| below this: the list is «close to the average MK» on the statement (no for/against)."
        }
      }
    },
    "statements": {
      "type": "array",
      "description": "Quiz statements in the order they are asked.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "title_en",
          "statement_en",
          "key",
          "d",
          "w"
        ],
        "properties": {
          "q": {
            "type": "string",
            "description": "Stable statement number; gaps are allowed (removed statements)."
          },
          "title_en": {
            "type": "string"
          },
          "statement_en": {
            "type": "string"
          },
          "key": {
            "$ref": "#/$defs/sign",
            "description": "+1: agreeing moves the direction up; -1: down."
          },
          "d": {
            "$ref": "#/$defs/dirId"
          },
          "w": {
            "type": "number",
            "description": "1, or 1/n when n statements share a direction."
          }
        }
      }
    },
    "directions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/dirId"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name_en",
          "plus_en",
          "minus_en"
        ],
        "properties": {
          "name_en": {
            "type": "string"
          },
          "plus_en": {
            "type": "string"
          },
          "minus_en": {
            "type": "string"
          }
        }
      }
    },
    "lists": {
      "type": "array",
      "description": "All 2026 lists; this order breaks ties in the ranking.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_en",
          "status",
          "ex_mks",
          "positions"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/listId"
          },
          "name_en": {
            "type": "string",
            "description": "Official English name (CEC)."
          },
          "status": {
            "enum": [
              "ok",
              "warning",
              "not_evaluated"
            ],
            "description": "warning: 1 ex-MK; not_evaluated: none."
          },
          "ex_mks": {
            "type": "integer",
            "minimum": 0
          },
          "positions": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/dirId"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "P",
                "P_bills",
                "e",
                "n_mk",
                "n_votes"
              ],
              "properties": {
                "P": {
                  "type": "number",
                  "description": "Position relative to the average MK."
                },
                "P_bills": {
                  "type": "number",
                  "description": "Part of P from the list's own bills (the rest is votes). Decides the «side comes from votes» line."
                },
                "e": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Evidence: sponsored bills + 0.25 * votes."
                },
                "n_mk": {
                  "type": "integer"
                },
                "n_votes": {
                  "type": "integer",
                  "description": "Votes on private bills on this direction (shown in explanations)."
                }
              }
            }
          }
        }
      }
    },
    "mks": {
      "type": "object",
      "description": "Candidates of 2026 lists who are former MKs (Knessets 24-25).",
      "propertyNames": {
        "$ref": "#/$defs/mkId"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name_en",
          "list",
          "list_position"
        ],
        "properties": {
          "name_en": {
            "type": "string",
            "description": "Transliteration (manual/mk_names_en.csv, not official)."
          },
          "list": {
            "$ref": "#/$defs/listId"
          },
          "list_position": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "by_direction": {
      "type": "object",
      "description": "Per quiz direction, the labeled bills in label order: [bill id, sign, role]. Order matters for ties.",
      "propertyNames": {
        "$ref": "#/$defs/dirId"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/billId"
            },
            {
              "$ref": "#/$defs/sign"
            },
            {
              "enum": [
                "main",
                "secondary"
              ]
            }
          ],
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "bills": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/billId"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name_he",
          "knesset",
          "url",
          "summary_en",
          "sponsors"
        ],
        "properties": {
          "name_he": {
            "type": "string",
            "description": "Original Hebrew title; never translated. Render with dir=\"auto\"."
          },
          "knesset": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          },
          "summary_en": {
            "type": [
              "string",
              "null"
            ],
            "description": "One-line English summary; null until decided."
          },
          "sponsors": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/mkId"
            },
            "description": "Sponsors who are 2026 candidates."
          }
        }
      }
    }
  }
}
