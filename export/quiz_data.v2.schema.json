{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quiz_data.v2.schema.json",
  "title": "Knesset 2026 quiz data, version 2",
  "description": "Produced by pipeline/export.py. The only input of web/. Formulas: docs/QUIZ_MATCHING.md; changes and the list-details format: export/V2_HANDOFF.md. v2 (2026-10-18): P = A + 0.25 V with A not centered, K = 0, P_bills, CLOSE, question order (flow, core). Written as three files loaded in order (V2_HANDOFF.md «Loading»): quiz_core.v2.json (version, generated, source_commit, flow, core, statements of the core), quiz_data.v2.json (version, generated, source_commit, params, flow, core, statements, directions, lists), quiz_bills.v2.json (version, generated, source_commit, mks, by_direction, bills). This schema describes their merge.",
  "type": "object",
  "required": [
    "version",
    "generated",
    "source_commit",
    "params",
    "statements",
    "directions",
    "lists",
    "mks",
    "by_direction",
    "bills",
    "flow",
    "core"
  ],
  "additionalProperties": false,
  "$defs": {
    "listId": {
      "type": "string",
      "description": "Ballot letters of the list (official CEC id), e.g. \"אמת\"."
    },
    "mkId": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "Knesset person id."
    },
    "billId": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "Knesset bill id."
    },
    "dirId": {
      "type": "string",
      "description": "Direction key, e.g. \"72\" or \"277a\"."
    },
    "sign": {
      "enum": [
        1,
        -1
      ]
    }
  },
  "properties": {
    "version": {
      "const": 2
    },
    "generated": {
      "type": "string",
      "format": "date"
    },
    "source_commit": {
      "type": "string"
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "K",
        "MIN_COVERAGE",
        "MAX_TRADE",
        "TRADE_TOP",
        "TRADE_W",
        "TRADE_CANDIDATES",
        "VOTE_WEIGHT",
        "CLOSE",
        "BILL_URL",
        "MIN_EX_MKS",
        "MIN_CLEAR_MKS",
        "MIN_CLEAR_BILLS"
      ],
      "properties": {
        "K": {
          "type": "number",
          "description": "Shrinkage: p = P * e / (e + K)."
        },
        "MIN_COVERAGE": {
          "type": "number",
          "description": "A list covering less of the answered weight is not ranked."
        },
        "MAX_TRADE": {
          "type": "integer",
          "description": "Max trade-off questions."
        },
        "TRADE_TOP": {
          "type": "integer",
          "description": "Trade-offs are asked only if they change the order of this top."
        },
        "TRADE_W": {
          "type": "number",
          "description": "Weight multiplier of the statement chosen in a trade-off."
        },
        "TRADE_CANDIDATES": {
          "type": "integer",
          "description": "Statements tried on each side per list."
        },
        "VOTE_WEIGHT": {
          "type": "number",
          "description": "Weight of a vote vs a sponsored bill in e (informational)."
        },
        "CLOSE": {
          "type": "number",
          "description": "|p| below this: the list «has no clear position» on the statement (no for/against)."
        },
        "BILL_URL": {
          "type": "string",
          "description": "Link to a bill on the Knesset site: replace {id} with the bill id."
        },
        "MIN_EX_MKS": {
          "type": "integer",
          "minimum": 1,
          "description": "A list with fewer former MKs is shown but not ranked (customer decision 2026-10-18)."
        },
        "MIN_CLEAR_MKS": {
          "type": "integer",
          "minimum": 1
        },
        "MIN_CLEAR_BILLS": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "statements": {
      "type": "array",
      "description": "Quiz statements in the order they are asked.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "title_en",
          "statement_en",
          "key",
          "d",
          "w"
        ],
        "properties": {
          "q": {
            "type": "string",
            "description": "Stable statement number; gaps are allowed (removed statements)."
          },
          "title_en": {
            "type": "string"
          },
          "statement_en": {
            "type": "string"
          },
          "key": {
            "$ref": "#/$defs/sign",
            "description": "+1: agreeing moves the direction up; -1: down."
          },
          "d": {
            "$ref": "#/$defs/dirId"
          },
          "w": {
            "type": "number",
            "description": "1, or 1/n when n statements share a direction."
          }
        }
      }
    },
    "directions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/dirId"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name_en",
          "plus_en",
          "minus_en"
        ],
        "properties": {
          "name_en": {
            "type": "string"
          },
          "plus_en": {
            "type": "string"
          },
          "minus_en": {
            "type": "string"
          }
        }
      }
    },
    "lists": {
      "type": "array",
      "description": "All 2026 lists; this order breaks ties in the ranking.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_en",
          "status",
          "ex_mks",
          "positions"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/listId"
          },
          "name_en": {
            "type": "string",
            "description": "Official English name (CEC)."
          },
          "status": {
            "enum": [
              "ok",
              "warning",
              "not_evaluated"
            ],
            "description": "warning: 1 ex-MK; not_evaluated: none."
          },
          "ex_mks": {
            "type": "integer",
            "minimum": 0
          },
          "positions": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/dirId"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "P",
                "P_bills",
                "e",
                "n_mk",
                "n_votes",
                "n_other",
                "n_names"
              ],
              "properties": {
                "P": {
                  "type": "number",
                  "description": "Position relative to the average MK."
                },
                "P_bills": {
                  "type": "number",
                  "description": "Part of P from the list's own bills (the rest is votes). Decides the «side comes from votes» line."
                },
                "e": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Evidence: sponsored bills + 0.25 * votes."
                },
                "n_mk": {
                  "type": "integer"
                },
                "n_votes": {
                  "type": "integer",
                  "description": "Votes on private bills on this direction (shown in explanations)."
                },
                "n_other": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Votes of the list's ex-MKs on the other camp's bills on this direction (basis line, 2026-10-18)."
                },
                "n_names": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Distinct bills (by name, sponsored or voted) behind the position; a clear position needs >= params.MIN_CLEAR_BILLS and n_mk >= params.MIN_CLEAR_MKS (2026-10-18)."
                }
              }
            }
          }
        }
      }
    },
    "mks": {
      "type": "object",
      "description": "Candidates of 2026 lists who are former MKs (Knessets 24-25).",
      "propertyNames": {
        "$ref": "#/$defs/mkId"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name_en",
          "list",
          "list_position"
        ],
        "properties": {
          "name_en": {
            "type": "string",
            "description": "Transliteration (manual/mk_names_en.csv, not official)."
          },
          "list": {
            "$ref": "#/$defs/listId"
          },
          "list_position": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "by_direction": {
      "type": "object",
      "description": "Per quiz direction, the labeled bills in label order: [bill id, sign, role]. Order matters for ties.",
      "propertyNames": {
        "$ref": "#/$defs/dirId"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/billId"
            },
            {
              "$ref": "#/$defs/sign"
            },
            {
              "enum": [
                "main",
                "secondary"
              ]
            }
          ],
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "bills": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/billId"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name_he",
          "knesset",
          "sponsors"
        ],
        "properties": {
          "name_he": {
            "type": "string",
            "description": "Original Hebrew title; never translated. Render with dir=\"auto\"."
          },
          "knesset": {
            "type": "integer"
          },
          "sponsors": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/mkId"
            },
            "description": "Sponsors who are 2026 candidates."
          }
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "description": "Order of questions (pipeline/quiz_flow.py FLOW): core statements, then clarifying ones chosen one by one, then trade-offs.",
      "required": [
        "core",
        "clarify",
        "trade",
        "core_r_max",
        "core_gov_share",
        "gov_r",
        "clarify_top",
        "stop_gap",
        "min_questions",
        "max_questions",
        "core_one_sided"
      ],
      "properties": {
        "core": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of core statements (the same for everyone)."
        },
        "clarify": {
          "type": "integer",
          "minimum": 0,
          "description": "Clarifying statements after the core when stop_gap is null."
        },
        "trade": {
          "type": "integer",
          "minimum": 0,
          "description": "Max trade-off questions."
        },
        "core_r_max": {
          "type": "number",
          "description": "Used to build the core (already applied in `core`)."
        },
        "core_gov_share": {
          "type": "number",
          "description": "Used to build the core (already applied in `core`)."
        },
        "gov_r": {
          "type": "number",
          "description": "Used to build the core (already applied in `core`)."
        },
        "clarify_top": {
          "type": "integer",
          "minimum": 0,
          "description": "How many lists of the current ranking are compared when choosing the next clarifying statement."
        },
        "stop_gap": {
          "type": [
            "number",
            "null"
          ],
          "description": "Stopping rule: stop when the leader's closeness exceeds the second's by this (null = off, use `clarify`)."
        },
        "min_questions": {
          "type": "integer",
          "minimum": 0,
          "description": "Stopping rule: not before this many statements."
        },
        "max_questions": {
          "type": "integer",
          "minimum": 0,
          "description": "Stopping rule: at most this many statements."
        },
        "core_one_sided": {
          "type": "boolean",
          "description": "false: statements on which every evaluated list with a clear position is on the same side are not in the core (2026-10-18)."
        }
      }
    },
    "core": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Core statements (`q`) in the order they are asked."
    }
  }
}
